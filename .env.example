# ============================================================
# SmartFix local development environment variables (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to `.env` and adjust values for YOUR machine.
# The real `.env` file must NEVER be committed to version control
# (it is ignored by .gitignore).
# Values below are local-development defaults only - they are NOT
# production secrets and are shared by docker-compose.yml so that
# `docker compose up` works out of the box.
# ============================================================

# PostgreSQL database created by docker-compose.yml
POSTGRES_DB=smartfix
POSTGRES_USER=smartfix
POSTGRES_PASSWORD=smartfix

# Host port the docker PostgreSQL is mapped to.
# If 5432 is already used on your machine (e.g. a locally installed PostgreSQL),
# change this to a free port and update DB_URL below to match.
DB_PORT=5432

# Spring Boot datasource (used when running the app on the host
# with `mvn spring-boot:run`; docker-compose overrides DB_URL to
# point at the `db` service).
DB_URL=jdbc:postgresql://localhost:5432/smartfix
DB_USERNAME=smartfix
DB_PASSWORD=smartfix

# Spring profile. The `dev` profile adds developer-friendly settings.
SPRING_PROFILES_ACTIVE=dev

# Enable once to create the first administrator. Set your own password locally.
# Compose passes these to the app. When running Maven on the host, export them
# in that terminal; Spring Boot does not automatically load this .env file.
SMARTFIX_BOOTSTRAP_ADMIN_ENABLED=false
SMARTFIX_BOOTSTRAP_ADMIN_USERNAME=
SMARTFIX_BOOTSTRAP_ADMIN_PASSWORD=
SMARTFIX_BOOTSTRAP_ADMIN_DISPLAY_NAME=SmartFix Administrator
SMARTFIX_SESSION_TIMEOUT=30m
# Set true when serving the application over HTTPS.
SMARTFIX_SESSION_COOKIE_SECURE=false

# Anonymous registration: atomic quotas within ONE application process.
# Export these when launching on the host. Compose must explicitly forward them;
# this .env file is not automatically loaded by Spring Boot.
SMARTFIX_REGISTRATION_MAX_PER_ADDRESS=5
SMARTFIX_REGISTRATION_WINDOW=PT1H
SMARTFIX_REGISTRATION_MAX_GLOBAL_PER_MINUTE=100
SMARTFIX_REGISTRATION_MAX_ADDRESSES=4096

# Persistent business notification delivery. Never put real SMTP secrets here.
SMARTFIX_DELIVERY_MAX_ATTEMPTS=4
SMARTFIX_DELIVERY_BATCH_SIZE=50
SMARTFIX_DELIVERY_RETRY_SECONDS=1
SMARTFIX_DELIVERY_SCAN_MILLISECONDS=15000
SMARTFIX_DELIVERY_SCHEDULING_ENABLED=true
SMARTFIX_DELIVERY_EAGER_ENABLED=true
# Optional business mail requires an administrator-set account contact.
SMARTFIX_NOTIFICATION_EMAIL_ENABLED=false
SMARTFIX_NOTIFICATION_EMAIL_FROM=smartfix@localhost
SMARTFIX_SMTP_HOST=localhost
SMARTFIX_SMTP_PORT=25
SMARTFIX_SMTP_USERNAME=
SMARTFIX_SMTP_PASSWORD=
SMARTFIX_SMTP_AUTH=false
SMARTFIX_SMTP_STARTTLS=false
SMARTFIX_SMTP_HEALTH_ENABLED=false
SMARTFIX_SLA_SCAN_MILLISECONDS=60000
