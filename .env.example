# ============================================================
# SmartFix local development environment variables (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to `.env` and adjust values for YOUR machine.
# The real `.env` file must NEVER be committed to version control
# (it is ignored by .gitignore).
# Values below are local-development defaults only - they are NOT
# production secrets and are shared by docker-compose.yml so that
# `docker compose up` works out of the box.
# ============================================================

# PostgreSQL database created by docker-compose.yml
POSTGRES_DB=smartfix
POSTGRES_USER=smartfix
POSTGRES_PASSWORD=smartfix

# Host port the docker PostgreSQL is mapped to.
# If 5432 is already used on your machine (e.g. a locally installed PostgreSQL),
# change this to a free port and update DB_URL below to match.
DB_PORT=5432

# Spring Boot datasource (used when running the app on the host
# with `mvn spring-boot:run`; docker-compose overrides DB_URL to
# point at the `db` service).
DB_URL=jdbc:postgresql://localhost:5432/smartfix
DB_USERNAME=smartfix
DB_PASSWORD=smartfix

# Spring profile. The `dev` profile adds developer-friendly settings.
SPRING_PROFILES_ACTIVE=dev
