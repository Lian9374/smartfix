{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SmartFix SWE5001 teaching MVP; paid resources; deploy only after cost approval",
  "Parameters": {
    "Project": {
      "Type": "String",
      "Default": "smartfix-swe5001",
      "AllowedPattern": "[a-z][a-z0-9-]{2,24}"
    },
    "ImageTag": {
      "Type": "String",
      "Default": "bootstrap"
    },
    "CoreCount": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "MaxValue": 4
    },
    "WorkerCount": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "MaxValue": 4
    },
    "CertificateArn": {
      "Type": "String",
      "Description": "ACM certificate in this region for DomainName"
    },
    "DomainName": {
      "Type": "String",
      "Description": "DNS name pointing to ALB; provision certificate and DNS first"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.51.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PublicSubnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.51.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true
      }
    },
    "PublicSubnet0Route": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet0"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "PrivateSubnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.51.10.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.51.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true
      }
    },
    "PublicSubnet1Route": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet1"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "PrivateSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.51.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "AlbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS ingress",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "TaskSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private application traffic",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "DataSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Database and EFS",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "AlbHttps": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "AlbSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "CidrIp": "0.0.0.0/0"
      }
    },
    "CoreFromAlb": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurity"
        }
      }
    },
    "CorePrivate": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "TaskSecurity"
        }
      }
    },
    "DatabaseFromTasks": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DataSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "TaskSecurity"
        }
      }
    },
    "EfsFromTasks": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DataSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 2049,
        "ToPort": 2049,
        "SourceSecurityGroupId": {
          "Ref": "TaskSecurity"
        }
      }
    },
    "CoreSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\": \"smartfix_core\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      }
    },
    "WorkerSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\": \"notification_worker\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      }
    },
    "AdminSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\": \"demo.admin\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      }
    },
    "InternalToken": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private database",
        "SubnetIds": [
          {
            "Ref": "PrivateSubnet0"
          },
          {
            "Ref": "PrivateSubnet1"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceClass": "db.t4g.micro",
        "Engine": "postgres",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MasterUsername": "postgres",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DataSecurity"
          }
        ],
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": 1,
        "DeletionProtection": true,
        "MultiAZ": false
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "Uploads": {
      "Type": "AWS::EFS::FileSystem",
      "Properties": {
        "Encrypted": true,
        "LifecyclePolicies": [
          {
            "TransitionToIA": "AFTER_7_DAYS"
          }
        ],
        "FileSystemPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "elasticfilesystem:*",
              "Resource": "*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "UploadMount0": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "Uploads"
        },
        "SubnetId": {
          "Ref": "PrivateSubnet0"
        },
        "SecurityGroups": [
          {
            "Ref": "DataSecurity"
          }
        ]
      }
    },
    "UploadMount1": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "Uploads"
        },
        "SubnetId": {
          "Ref": "PrivateSubnet1"
        },
        "SecurityGroups": [
          {
            "Ref": "DataSecurity"
          }
        ]
      }
    },
    "UploadAccess": {
      "Type": "AWS::EFS::AccessPoint",
      "Properties": {
        "FileSystemId": {
          "Ref": "Uploads"
        },
        "PosixUser": {
          "Uid": "10001",
          "Gid": "10001"
        },
        "RootDirectory": {
          "Path": "/uploads",
          "CreationInfo": {
            "OwnerUid": "10001",
            "OwnerGid": "10001",
            "Permissions": "0750"
          }
        }
      }
    },
    "DeadLetters": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "Queue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 120,
        "ReceiveMessageWaitTimeSeconds": 20,
        "MessageRetentionPeriod": 345600,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeadLetters",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        }
      }
    },
    "QueueTls": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "Queue"
          },
          {
            "Ref": "DeadLetters"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sqs:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Queue",
                    "Arn"
                  ]
                },
                {
                  "Fn::GetAtt": [
                    "DeadLetters",
                    "Arn"
                  ]
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "CoreRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": {
          "Fn::Sub": "${Project}-core"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"selection\": {\"tagStatus\": \"any\", \"countType\": \"imageCountMoreThan\", \"countNumber\": 10}, \"action\": {\"type\": \"expire\"}}]}"
        }
      }
    },
    "WorkerRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": {
          "Fn::Sub": "${Project}-worker"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"selection\": {\"tagStatus\": \"any\", \"countType\": \"imageCountMoreThan\", \"countNumber\": 10}, \"action\": {\"type\": \"expire\"}}]}"
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/ecs/${Project}"
        },
        "RetentionInDays": 7
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "CoreSecret"
                    },
                    {
                      "Ref": "WorkerSecret"
                    },
                    {
                      "Ref": "InternalToken"
                    },
                    {
                      "Ref": "AdminSecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "CoreRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [],
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Queue",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "elasticfilesystem:ClientMount",
                    "elasticfilesystem:ClientWrite"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Uploads",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [],
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Queue",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "InitRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [],
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Database",
                        "MasterUserSecret.SecretArn"
                      ]
                    },
                    {
                      "Ref": "CoreSecret"
                    },
                    {
                      "Ref": "WorkerSecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": {
          "Ref": "Project"
        },
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "Namespace": {
      "Type": "AWS::ServiceDiscovery::PrivateDnsNamespace",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Project}.local"
        },
        "Vpc": {
          "Ref": "Vpc"
        }
      }
    },
    "CoreDiscovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "core",
        "NamespaceId": {
          "Ref": "Namespace"
        },
        "DnsConfig": {
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "CoreTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${Project}-core"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "CoreRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "core",
            "Image": {
              "Fn::Sub": "${CoreRepository.RepositoryUri}:${ImageTag}"
            },
            "Essential": true,
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "SMARTFIX_QUEUE_URL",
                "Value": {
                  "Ref": "Queue"
                }
              },
              {
                "Name": "SPRING_PROFILES_ACTIVE",
                "Value": "distributed"
              },
              {
                "Name": "DB_URL",
                "Value": {
                  "Fn::Sub": "jdbc:postgresql://${Database.Endpoint.Address}:5432/smartfix?sslmode=require"
                }
              },
              {
                "Name": "DB_USERNAME",
                "Value": "smartfix_core"
              },
              {
                "Name": "SMARTFIX_UPLOAD_DIR",
                "Value": "/app/uploads"
              },
              {
                "Name": "SMARTFIX_BOOTSTRAP_ADMIN_ENABLED",
                "Value": "true"
              },
              {
                "Name": "SMARTFIX_BOOTSTRAP_ADMIN_USERNAME",
                "Value": "demo.admin"
              },
              {
                "Name": "SMARTFIX_SESSION_COOKIE_SECURE",
                "Value": "true"
              },
              {
                "Name": "SERVER_FORWARD_HEADERS_STRATEGY",
                "Value": "native"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${CoreSecret}:password::"
                }
              },
              {
                "Name": "SMARTFIX_INTERNAL_TOKEN",
                "ValueFrom": {
                  "Ref": "InternalToken"
                }
              },
              {
                "Name": "SMARTFIX_BOOTSTRAP_ADMIN_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${AdminSecret}:password::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "core"
              }
            },
            "PortMappings": [
              {
                "ContainerPort": 8080
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "uploads",
                "ContainerPath": "/app/uploads"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "curl -fsS http://localhost:8081/actuator/health/readiness || exit 1"
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 120
            }
          }
        ],
        "Volumes": [
          {
            "Name": "uploads",
            "EFSVolumeConfiguration": {
              "FilesystemId": {
                "Ref": "Uploads"
              },
              "TransitEncryption": "ENABLED",
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Ref": "UploadAccess"
                },
                "IAM": "ENABLED"
              }
            }
          }
        ]
      }
    },
    "WorkerTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${Project}-worker"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "worker",
            "Image": {
              "Fn::Sub": "${WorkerRepository.RepositoryUri}:${ImageTag}"
            },
            "Essential": true,
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "SMARTFIX_QUEUE_URL",
                "Value": {
                  "Ref": "Queue"
                }
              },
              {
                "Name": "CORE_URL",
                "Value": {
                  "Fn::Sub": "http://core.${Project}.local:8080"
                }
              },
              {
                "Name": "WORKER_DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "WORKER_DB_NAME",
                "Value": "notifications"
              },
              {
                "Name": "WORKER_DB_SSLMODE",
                "Value": "require"
              }
            ],
            "Secrets": [
              {
                "Name": "WORKER_DB_USER",
                "ValueFrom": {
                  "Fn::Sub": "${WorkerSecret}:username::"
                }
              },
              {
                "Name": "WORKER_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${WorkerSecret}:password::"
                }
              },
              {
                "Name": "SMARTFIX_INTERNAL_TOKEN",
                "ValueFrom": {
                  "Ref": "InternalToken"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "worker"
              }
            }
          }
        ]
      }
    },
    "InitTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${Project}-db-init"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "InitRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "db-init",
            "Image": {
              "Fn::Sub": "${WorkerRepository.RepositoryUri}:${ImageTag}"
            },
            "Essential": true,
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "MASTER_SECRET_ARN",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "MasterUserSecret.SecretArn"
                  ]
                }
              },
              {
                "Name": "CORE_SECRET_ARN",
                "Value": {
                  "Ref": "CoreSecret"
                }
              },
              {
                "Name": "WORKER_SECRET_ARN",
                "Value": {
                  "Ref": "WorkerSecret"
                }
              }
            ],
            "Secrets": [],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "db-init"
              }
            },
            "Command": [
              "python",
              "init_db.py"
            ]
          }
        ]
      }
    },
    "Balancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Subnets": [
          {
            "Ref": "PublicSubnet0"
          },
          {
            "Ref": "PublicSubnet1"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSecurity"
          }
        ]
      }
    },
    "Target": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Protocol": "HTTP",
        "Port": 8080,
        "TargetType": "ip",
        "HealthCheckPath": "/actuator/health/readiness",
        "HealthCheckPort": "8081",
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "HealthFromAlb": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 8081,
        "ToPort": 8081,
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurity"
        }
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Balancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "BlockInternal": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 1,
        "Conditions": [
          {
            "Field": "path-pattern",
            "Values": [
              "/internal/*",
              "/actuator/*"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "403",
              "ContentType": "text/plain",
              "MessageBody": "Forbidden"
            }
          }
        ]
      }
    },
    "CoreService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "CoreTask"
        },
        "DesiredCount": {
          "Ref": "CoreCount"
        },
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "PublicSubnet0"
              },
              {
                "Ref": "PublicSubnet1"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskSecurity"
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200
        },
        "LoadBalancers": [
          {
            "ContainerName": "core",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ],
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "CoreDiscovery",
                "Arn"
              ]
            }
          }
        ],
        "HealthCheckGracePeriodSeconds": 120
      },
      "DependsOn": [
        "Listener",
        "UploadMount0",
        "UploadMount1"
      ]
    },
    "WorkerService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "WorkerTask"
        },
        "DesiredCount": {
          "Ref": "WorkerCount"
        },
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "PublicSubnet0"
              },
              {
                "Ref": "PublicSubnet1"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskSecurity"
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200
        }
      },
      "DependsOn": [
        "Listener",
        "UploadMount0",
        "UploadMount1"
      ]
    },
    "CoreServiceScaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MaxCapacity": 4,
        "MinCapacity": {
          "Ref": "CoreCount"
        },
        "ResourceId": {
          "Fn::Sub": "service/${Cluster}/${CoreService.Name}"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      }
    },
    "CoreServiceCpuPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${Project}-CoreService-cpu"
        },
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "CoreServiceScaling"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 60,
          "ScaleInCooldown": 120,
          "ScaleOutCooldown": 60,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          }
        }
      }
    },
    "WorkerServiceScaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MaxCapacity": 4,
        "MinCapacity": {
          "Ref": "WorkerCount"
        },
        "ResourceId": {
          "Fn::Sub": "service/${Cluster}/${WorkerService.Name}"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      }
    },
    "WorkerServiceCpuPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${Project}-WorkerService-cpu"
        },
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "WorkerServiceScaling"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 60,
          "ScaleInCooldown": 120,
          "ScaleOutCooldown": 60,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          }
        }
      }
    },
    "DlqAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Poison notifications require investigation and replay",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "DeadLetters",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "Dashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": {
          "Ref": "Project"
        },
        "DashboardBody": {
          "Fn::Sub": "{\"widgets\": [{\"type\": \"metric\", \"width\": 12, \"height\": 6, \"properties\": {\"title\": \"Queue backlog\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/SQS\", \"ApproximateNumberOfMessagesVisible\", \"QueueName\", \"${Queue.QueueName}\"], [\"AWS/SQS\", \"ApproximateNumberOfMessagesVisible\", \"QueueName\", \"${DeadLetters.QueueName}\"]], \"period\": 60, \"stat\": \"Maximum\"}}, {\"type\": \"metric\", \"width\": 12, \"height\": 6, \"properties\": {\"title\": \"Core CPU and memory\", \"region\": \"${AWS::Region}\", \"metrics\": [[\"AWS/ECS\", \"CPUUtilization\", \"ClusterName\", \"${Cluster}\", \"ServiceName\", \"${CoreService.Name}\"], [\"AWS/ECS\", \"MemoryUtilization\", \"ClusterName\", \"${Cluster}\", \"ServiceName\", \"${CoreService.Name}\"]], \"period\": 60, \"stat\": \"Average\"}}]}"
        }
      }
    }
  },
  "Outputs": {
    "Url": {
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      }
    },
    "AlbDns": {
      "Value": {
        "Fn::GetAtt": [
          "Balancer",
          "DNSName"
        ]
      }
    },
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "CoreService": {
      "Value": {
        "Fn::GetAtt": [
          "CoreService",
          "Name"
        ]
      }
    },
    "WorkerService": {
      "Value": {
        "Fn::GetAtt": [
          "WorkerService",
          "Name"
        ]
      }
    },
    "CoreRepository": {
      "Value": {
        "Fn::GetAtt": [
          "CoreRepository",
          "RepositoryUri"
        ]
      }
    },
    "WorkerRepository": {
      "Value": {
        "Fn::GetAtt": [
          "WorkerRepository",
          "RepositoryUri"
        ]
      }
    },
    "InitTask": {
      "Value": {
        "Ref": "InitTask"
      }
    },
    "Subnets": {
      "Value": {
        "Fn::Join": [
          ",",
          [
            {
              "Ref": "PublicSubnet0"
            },
            {
              "Ref": "PublicSubnet1"
            }
          ]
        ]
      }
    },
    "TaskSecurity": {
      "Value": {
        "Ref": "TaskSecurity"
      }
    },
    "QueueUrl": {
      "Value": {
        "Ref": "Queue"
      }
    },
    "DlqUrl": {
      "Value": {
        "Ref": "DeadLetters"
      }
    },
    "AdminSecret": {
      "Value": {
        "Ref": "AdminSecret"
      }
    },
    "Database": {
      "Value": {
        "Ref": "Database"
      }
    }
  }
}
