{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notification.requested.v1",
  "type": "object",
  "required": ["schemaVersion","eventType","taskId","dedupKey","recipientId","channel","notificationType","title","message","occurredAt"],
  "properties": {
    "schemaVersion": {"const":1}, "eventType":{"const":"notification.requested.v1"},
    "taskId":{"type":"integer","minimum":1}, "recipientId":{"type":"integer","minimum":1},
    "dedupKey":{"type":"string","minLength":1,"maxLength":200},
    "channel":{"enum":["IN_APP","EMAIL"]}, "notificationType":{"type":"string","minLength":1,"maxLength":80},
    "title":{"type":"string","minLength":1,"maxLength":150}, "message":{"type":"string","minLength":1,"maxLength":1000},
    "referenceId":{"type":["integer","null"],"minimum":1}, "email":{"type":["string","null"],"maxLength":254},
    "occurredAt":{"type":"string","format":"date-time"}
  }
}
